# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=<minimum_32_char_random_secret>
JWT_EXPIRES_IN=7d

# ─── Groq AI (Required) ──────────────────────────────────────────────────────
GROQ_API_KEY=<your_groq_api_key>

# ─── Groq AI (Optional — safe defaults apply if omitted) ─────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile  # Model name — change here to swap across entire app
# GROQ_TIMEOUT_MS=30000               # Per-attempt hard timeout in milliseconds
# GROQ_MAX_RETRIES=3                  # Max retry attempts for retryable errors (rate limit, server errors)

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
